static int stitch_with_imagemagick(Config* cfg) {
    printf("\n=== Stitching tiles with ImageMagick (low memory) ===\n");
    
    int check = system("magick --version > nul 2>&1");
    if (check != 0) {
        printf("Warning: ImageMagick not found!\n");
        printf("Install with: pacman -S mingw-w64-x86_64-imagemagick\n");
        printf("Or stitch manually using: magick montage ...\n");
        return 0;
    }
    
    int tiles_x = (cfg->width + cfg->tile_size - 1) / cfg->tile_size;
    int tiles_y = (cfg->height + cfg->tile_size - 1) / cfg->tile_size;
    
    char batch_file[512];
    snprintf(batch_file, sizeof(batch_file), "%s/stitch.bat", cfg->tile_dir);
    
    FILE* bat = fopen(batch_file, "w");
    if (!bat) {
        printf("Failed to create batch file\n");
        return 0;
    }
    
    fprintf(bat, "cd /d \"%s\"\n", cfg->tile_dir);
    fprintf(bat, "magick montage");
    
    for (int ty = 0; ty < tiles_y; ty++) {
        for (int tx = 0; tx < tiles_x; tx++) {
            fprintf(bat, " tile_%d_%d.png", tx, ty);
        }
    }
    
    fprintf(bat, " -tile %dx%d -geometry +0+0 -background black \"%s\"\n", 
            tiles_x, tiles_y, cfg->output_file);
    
    fclose(bat);
    
    printf("Stitching %d tiles (%dx%d grid)...\n", tiles_x * tiles_y, tiles_x, tiles_y);
    printf("Running ImageMagick...\n");
    fflush(stdout);
    
    char cmd[1024];
    snprintf(cmd, sizeof(cmd), "call \"%s\"", batch_file);
    int result = system(cmd);
    
    if (result == 0) {
        printf("Final image saved to: %s\n", cfg->output_file);
        return 1;
    } else {
        printf("ImageMagick stitching failed with code %d\n", result);
        return 0;
    }
}

/* ===========================================
   Main Rendering Function (UPDATED with AVX-512)
   =========================================== */

static void render_mandelbrot(Config* cfg, uint8_t* image) {
    clock_t total_start = clock();
    
    if (cfg->use_tiles) {
        if (cfg->use_gpu) {
            double tile_time = gpu_render_tiled(cfg, image);
            if (tile_time > 0) {
                printf("GPU Tiles: %.3f seconds\n", tile_time);
                return;
            }
            printf("GPU tile rendering failed, falling back to CPU tiles\n");
        }
        double tile_time = render_tiled(cfg, image);
        if (tile_time > 0) {
            printf("CPU Tiles: %.3f seconds\n", tile_time);
            return;
        }
        return;
    }
    
    if (cfg->use_gpu) {
        printf("\nGPU Rendering...\n");
        double gpu_time = gpu_render(cfg, image);
        if (gpu_time > 0) {
            printf("GPU: %.3f seconds\n", gpu_time);
            return;
        }
        printf("GPU failed, using CPU\n");
        cfg->use_gpu = 0;
    }
    
    printf("\nCPU Rendering...\n");
    
    // AVX-512 detection and usage
    int use_avx512 = cfg->use_avx512 && (cfg->cpu_features & CPU_FEATURE_AVX512);
    int use_avx2 = cfg->use_avx2 && (cfg->cpu_features & CPU_FEATURE_AVX2);
    
#ifdef __AVX512F__
    if (use_avx512) {
        printf("Using: AVX-512 + OpenMP\n");
    } else
#endif
#ifdef __AVX2__
    if (use_avx2) {
        printf("Using: AVX2 + OpenMP\n");
    } else
#endif
    {
        printf("Using: Scalar + OpenMP\n");
    }
    
    int num_threads = cfg->num_threads;
    int actual_threads = num_threads ? num_threads : omp_get_max_threads();
    printf("Threads: %d\n", actual_threads);
    
    clock_t cpu_start = clock();
    double dx = (cfg->x_max - cfg->x_min) / cfg->width;
    double dy = (cfg->y_max - cfg->y_min) / cfg->height;
    
    #pragma omp parallel for num_threads(num_threads > 0 ? num_threads : omp_get_max_threads())
    for (int y = 0; y < cfg->height; y++) {
        double y0 = cfg->y_min + y * dy;
        int x = 0;
        
#ifdef __AVX512F__
        if (use_avx512) {
            // Process 8 pixels at a time with AVX-512
            for (; x <= cfg->width - 8; x += 8) {
                double x_coords[8] __attribute__((aligned(64)));
                for (int k = 0; k < 8; k++)
                    x_coords[k] = cfg->x_min + (x + k) * dx;
                
                __m512d x0_vec = _mm512_load_pd(x_coords);
                __m512d y0_vec = _mm512_set1_pd(y0);
                int results[8];
                mandelbrot_avx512(x0_vec, y0_vec, cfg->max_iter, results);
                
                for (int k = 0; k < 8; k++) {
                    int idx = (y * cfg->width + (x + k)) * 3;
                    uint8_t r, g, b;
                    get_color(results[k], cfg->max_iter, cfg->grayscale, 
                              cfg->gamma, cfg->brightness, &r, &g, &b);
                    image[idx] = r; image[idx+1] = g; image[idx+2] = b;
                }
            }
        }
#endif
        
#ifdef __AVX2__
        if (use_avx2 && !use_avx512) {
            // Process 4 pixels at a time with AVX2
            for (; x <= cfg->width - 4; x += 4) {
                double x_coords[4] __attribute__((aligned(32)));
                for (int k = 0; k < 4; k++)
                    x_coords[k] = cfg->x_min + (x + k) * dx;
                
                __m256d x0_vec = _mm256_load_pd(x_coords);
                __m256d y0_vec = _mm256_set1_pd(y0);
                int results[4];
                mandelbrot_avx2(x0_vec, y0_vec, cfg->max_iter, results);
                
                for (int k = 0; k < 4; k++) {
                    int idx = (y * cfg->width + (x + k)) * 3;
                    uint8_t r, g, b;
                    get_color(results[k], cfg->max_iter, cfg->grayscale, 
                              cfg->gamma, cfg->brightness, &r, &g, &b);
                    image[idx] = r; image[idx+1] = g; image[idx+2] = b;
                }
            }
        }
#endif
        
        // Scalar fallback for remaining pixels
        for (; x < cfg->width; x++) {
            double x0 = cfg->x_min + x * dx;
            int iter = mandelbrot_scalar(x0, y0, cfg->max_iter);
            int idx = (y * cfg->width + x) * 3;
            uint8_t r, g, b;
            get_color(iter, cfg->max_iter, cfg->grayscale, 
                      cfg->gamma, cfg->brightness, &r, &g, &b);
            image[idx] = r; image[idx+1] = g; image[idx+2] = b;
        }
    }
    
    clock_t cpu_end = clock();
    double cpu_time = (double)(cpu_end - cpu_start) / CLOCKS_PER_SEC;
    double total_time = (double)(clock() - total_start) / CLOCKS_PER_SEC;
    
    printf("\nCPU (%d threads, %s): %.3f seconds\n", 
           actual_threads, 
#ifdef __AVX512F__
           use_avx512 ? "AVX-512" :
#endif
#ifdef __AVX2__
           use_avx2 ? "AVX2" :
#endif
           "Scalar", 
           cpu_time);
    printf("Performance: %.1f MPixels/second\n", (cfg->width * cfg->height) / (cpu_time * 1000000.0));
    printf("Total: %.3f seconds\n", total_time);
}

/* ===========================================
   PNG & PPM File I/O
   =========================================== */

static int save_png(const char* filename, uint8_t* image, int width, int height) {
    FILE *fp = fopen(filename, "wb");
    if (!fp) { perror("Failed to open file"); return 0; }
    
    png_structp png_ptr = png_create_write_struct(PNG_LIBPNG_VER_STRING, NULL, NULL, NULL);
    if (!png_ptr) { fclose(fp); return 0; }
    
    png_infop info_ptr = png_create_info_struct(png_ptr);
    if (!info_ptr) { png_destroy_write_struct(&png_ptr, NULL); fclose(fp); return 0; }
    
    if (setjmp(png_jmpbuf(png_ptr))) {
        png_destroy_write_struct(&png_ptr, &info_ptr);
        fclose(fp);
        return 0;
    }
    
    png_init_io(png_ptr, fp);
    png_set_IHDR(png_ptr, info_ptr, width, height, 8, PNG_COLOR_TYPE_RGB,
                 PNG_INTERLACE_NONE, PNG_COMPRESSION_TYPE_DEFAULT, PNG_FILTER_TYPE_DEFAULT);
    png_write_info(png_ptr, info_ptr);
    
    png_bytep row_pointers[height];
    for (int y = 0; y < height; y++)
        row_pointers[y] = (png_bytep)(image + y * width * 3);
    
    png_write_image(png_ptr, row_pointers);
    png_write_end(png_ptr, NULL);
    png_destroy_write_struct(&png_ptr, &info_ptr);
    fclose(fp);
    return 1;
}

static int save_ppm(const char* filename, uint8_t* image, int width, int height) {
    FILE* fp = fopen(filename, "wb");
    if (!fp) { perror("Failed to open file"); return 0; }
    
    fprintf(fp, "P6\n%d %d\n255\n", width, height);
    size_t written = fwrite(image, 1, width * height * 3, fp);
    fclose(fp);
    return written == width * height * 3;
}


    printf("Examples:\n");
    printf("  mandelbrot -w 1920 -h 1080 -i 5000 -o output.png\n");
    printf("  mandelbrot --gpu -x -0.745428 -X -0.745427 -y 0.113009 -Y 0.113010 -i 50000\n");
    printf("  mandelbrot --avx512 -w 40000 -h 20000 --tile-size 3840 -o huge.png\n");
}

static void parse_args(int argc, char** argv, Config* cfg) {
    cfg->width = 1920;
    cfg->height = 1080;
    cfg->max_iter = 1000;
    cfg->x_min = -2.5;
    cfg->x_max = 1.5;
    cfg->y_min = -1.5;
    cfg->y_max = 1.5;
    cfg->use_gpu = 0;
    cfg->use_avx2 = 1;
    cfg->use_avx512 = 0;  // Default OFF
    cfg->use_sse4 = 1;
    cfg->num_threads = 0;
    cfg->grayscale = 0;
    cfg->benchmark = 0;
    cfg->output_file = "mandelbrot.ppm";
    cfg->cpu_features = detect_cpu_features();
    cfg->gamma = 0.3f;
    cfg->brightness = 1.0f;
    
    cfg->use_tiles = 0;
    cfg->tile_size = 1080;
    strcpy(cfg->tile_dir, "tiles");

    for (int i = 1; i < argc; i++) {
        if (strcmp(argv[i], "--help") == 0) { print_help(); exit(0); }
        else if (strcmp(argv[i], "--width") == 0 || strcmp(argv[i], "-w") == 0) { if (++i < argc) cfg->width = atoi(argv[i]); }
        else if (strcmp(argv[i], "--height") == 0 || strcmp(argv[i], "-h") == 0) { if (++i < argc) cfg->height = atoi(argv[i]); }
        else if (strcmp(argv[i], "--iter") == 0 || strcmp(argv[i], "-i") == 0) { if (++i < argc) cfg->max_iter = atoi(argv[i]); }
        else if (strcmp(argv[i], "--xmin") == 0 || strcmp(argv[i], "-x") == 0) { if (++i < argc) cfg->x_min = atof(argv[i]); }
        else if (strcmp(argv[i], "--xmax") == 0 || strcmp(argv[i], "-X") == 0) { if (++i < argc) cfg->x_max = atof(argv[i]); }
        else if (strcmp(argv[i], "--ymin") == 0 || strcmp(argv[i], "-y") == 0) { if (++i < argc) cfg->y_min = atof(argv[i]); }
        else if (strcmp(argv[i], "--ymax") == 0 || strcmp(argv[i], "-Y") == 0) { if (++i < argc) cfg->y_max = atof(argv[i]); }
        else if (strcmp(argv[i], "--grayscale") == 0 || strcmp(argv[i], "-g") == 0) { cfg->grayscale = 1; }
        else if (strcmp(argv[i], "--output") == 0 || strcmp(argv[i], "-o") == 0) { if (++i < argc) cfg->output_file = argv[i]; }
        else if (strcmp(argv[i], "--threads") == 0 || strcmp(argv[i], "-t") == 0) { if (++i < argc) cfg->num_threads = atoi(argv[i]); }
        else if (strcmp(argv[i], "--avx512") == 0) { 
            cfg->use_avx512 = 1; 
            cfg->use_avx2 = 0;  // AVX-512 supersedes AVX2
        }
        else if (strcmp(argv[i], "--no-avx2") == 0) { cfg->use_avx2 = 0; }
        else if (strcmp(argv[i], "--gpu") == 0) { cfg->use_gpu = 1; }
        else if (strcmp(argv[i], "--benchmark") == 0) { cfg->benchmark = 1; }
        else if (strcmp(argv[i], "--gamma") == 0) { if (++i < argc) cfg->gamma = atof(argv[i]); }
        else if (strcmp(argv[i], "--brightness") == 0) { if (++i < argc) cfg->brightness = atof(argv[i]); }
        else if (strcmp(argv[i], "--tile-size") == 0 && i + 1 < argc) { 
            i++; 
            cfg->tile_size = atoi(argv[i]);
            cfg->use_tiles = 1;
        }
    }
    
    if ((long long)cfg->width * cfg->height > 100000000) {
        cfg->use_tiles = 1;
        printf("Auto-enabling tile mode for large image (%dx%d = %lld MP)\n", 
               cfg->width, cfg->height, (long long)cfg->width * cfg->height / 1000000);
    }
}

/* ===========================================
   Benchmark Function
   =========================================== */

static void run_benchmark(Config* cfg) {
    printf("\n=== Performance Benchmark ===\n");
    int test_iterations[] = {256, 1000, 4000, 16000, 32000};
    int num_tests = sizeof(test_iterations) / sizeof(test_iterations[0]);
    
    int orig_width = cfg->width, orig_height = cfg->height;
    cfg->width = 640; cfg->height = 480;
    uint8_t* test_image = malloc(cfg->width * cfg->height * 3);
    if (!test_image) { printf("Memory allocation failed\n"); return; }
    
    for (int i = 0; i < num_tests; i++) {
        cfg->max_iter = test_iterations[i];
        clock_t start = clock();
        render_mandelbrot(cfg, test_image);
        clock_t end = clock();
        double time = (double)(end - start) / CLOCKS_PER_SEC;
        printf("  %5d iterations: %.3f seconds\n", test_iterations[i], time);
    }
    
    cfg->width = orig_width; cfg->height = orig_height;
    free(test_image);
}

/* ===========================================
   Main Function
   =========================================== */

int main(int argc, char** argv) {
    Config cfg;
    parse_args(argc, argv, &cfg);
    
    printf("=== Ultimate Mandelbrot Renderer ===\n");
    printf("Resolution: %dx%d\n", cfg.width, cfg.height);
    printf("Iterations: %d\n", cfg.max_iter);
    printf("Viewport: [%.6f, %.6f] x [%.6f, %.6f]\n", cfg.x_min, cfg.x_max, cfg.y_min, cfg.y_max);
    printf("Mode: %s\n", cfg.use_gpu ? "GPU" : "CPU");
    if (cfg.use_avx512) printf("AVX-512: ENABLED\n");
    if (cfg.use_tiles) {
        printf("Tile mode: enabled (tile size: %dx%d)\n", cfg.tile_size, cfg.tile_size);
    }
    printf("Color: %s\n", cfg.grayscale ? "Grayscale" : "RGB");
    printf("Gamma: %.2f, Brightness: %.2f\n", cfg.gamma, cfg.brightness);
    printf("CPU Features: ");
    if (cfg.cpu_features & CPU_FEATURE_AVX512) printf("AVX-512 ");
    if (cfg.cpu_features & CPU_FEATURE_AVX2) printf("AVX2 ");
    if (cfg.cpu_features & CPU_FEATURE_SSE4_2) printf("SSE4.2 ");
    if (cfg.cpu_features & CPU_FEATURE_SSE4_1) printf("SSE4.1 ");
    if (cfg.cpu_features & CPU_FEATURE_SSE3) printf("SSE3 ");
    if (cfg.cpu_features == CPU_FEATURE_NONE) printf("Scalar only");
    printf("\n");
    
    if (cfg.benchmark) run_benchmark(&cfg);
    
    uint8_t* image = NULL;
    
    if (!cfg.use_tiles) {
        printf("Allocating image buffer...\n");
        image = malloc(cfg.width * cfg.height * 3);
        if (!image) {
            fprintf(stderr, "Failed to allocate memory\n");
            return 1;
        }
    } else {
        printf("Using tile rendering (tiles will be stitched automatically)\n");
    }
    
    printf("Starting render...\n");
    render_mandelbrot(&cfg, image);
    
    if (image) {
        const char* ext = strrchr(cfg.output_file, '.');
        int success = 0;
        if (ext && (strcmp(ext, ".png") == 0 || strcmp(ext, ".PNG") == 0))
            success = save_png(cfg.output_file, image, cfg.width, cfg.height);
        else
            success = save_ppm(cfg.output_file, image, cfg.width, cfg.height);
        
        if (success) printf("Image saved to: %s\n", cfg.output_file);
        else fprintf(stderr, "Failed to save image\n");
        
        free(image);
    }
    
#ifdef USE_OPENCL
    gpu_cleanup();
#endif
    
    printf("\nDone!\n");
    return 0;
}
// ========== TILE RENDERING FUNCTIONS ==========

static double gpu_render(Config* cfg, uint8_t* image);

static double render_tile(Config* cfg, int tile_x, int tile_y, int tile_w, int tile_h, int start_x, int start_y) {
    double total_dx = (cfg->x_max - cfg->x_min) / cfg->width;
    double total_dy = (cfg->y_max - cfg->y_min) / cfg->height;
    
    double tile_x_min = cfg->x_min + start_x * total_dx;
    double tile_x_max = tile_x_min + tile_w * total_dx;
    double tile_y_min = cfg->y_min + start_y * total_dy;
    double tile_y_max = tile_y_min + tile_h * total_dy;
    
    uint8_t* tile_image = (uint8_t*)malloc(tile_w * tile_h * 3);
    if (!tile_image) return -1.0;
    
    Config tile_cfg = *cfg;
    tile_cfg.width = tile_w;
    tile_cfg.height = tile_h;
    tile_cfg.x_min = tile_x_min;
    tile_cfg.x_max = tile_x_max;
    tile_cfg.y_min = tile_y_min;
    tile_cfg.y_max = tile_y_max;
    tile_cfg.use_tiles = 0;  // Prevent recursion
    
    clock_t start = clock();
    
    if (cfg->use_gpu) {
        if (!g_ctx.initialized) gpu_init();
        double gpu_time = gpu_render(&tile_cfg, tile_image);
        if (gpu_time < 0) {
            free(tile_image);
            return -1.0;
        }
    } else {
        #pragma omp parallel for
        for (int y = 0; y < tile_h; y++) {
            double y0 = tile_cfg.y_min + y * total_dy;
            for (int x = 0; x < tile_w; x++) {
                double x0 = tile_cfg.x_min + x * total_dx;
                int iter = mandelbrot_scalar(x0, y0, cfg->max_iter);
                int idx = (y * tile_w + x) * 3;
                uint8_t r, g, b;
                get_color(iter, cfg->max_iter, cfg->grayscale, 
                          cfg->gamma, cfg->brightness, &r, &g, &b);
                tile_image[idx] = r;
                tile_image[idx+1] = g;
                tile_image[idx+2] = b;
            }
        }
    }
    
    clock_t end = clock();
    double time = (double)(end - start) / CLOCKS_PER_SEC;
    
    char tile_filename[512];
    snprintf(tile_filename, sizeof(tile_filename), "%s/tile_%d_%d.png", cfg->tile_dir, tile_x, tile_y);
    
    FILE* fp = fopen(tile_filename, "wb");
    if (fp) {
        png_structp png_ptr = png_create_write_struct(PNG_LIBPNG_VER_STRING, NULL, NULL, NULL);
        if (png_ptr) {
            png_infop info_ptr = png_create_info_struct(png_ptr);
            if (info_ptr && !setjmp(png_jmpbuf(png_ptr))) {
                png_init_io(png_ptr, fp);
                png_set_IHDR(png_ptr, info_ptr, tile_w, tile_h, 8, PNG_COLOR_TYPE_RGB,
                             PNG_INTERLACE_NONE, PNG_COMPRESSION_TYPE_DEFAULT, PNG_FILTER_TYPE_DEFAULT);
                png_write_info(png_ptr, info_ptr);
                
                png_bytep row_pointers[tile_h];
                for (int y = 0; y < tile_h; y++)
                    row_pointers[y] = (png_bytep)(tile_image + y * tile_w * 3);
                png_write_image(png_ptr, row_pointers);
                png_write_end(png_ptr, NULL);
            }
            png_destroy_write_struct(&png_ptr, &info_ptr);
        }
        fclose(fp);
    }
    
    free(tile_image);
    return time;
}

static double render_tiled(Config* cfg, uint8_t* image) {
    (void)image;
    printf("\n=== TILE RENDERING MODE ===\n");
    printf("Tile size: %dx%d pixels\n", cfg->tile_size, cfg->tile_size);
    printf("Image size: %dx%d pixels\n", cfg->width, cfg->height);
    
    snprintf(cfg->tile_dir, sizeof(cfg->tile_dir), "tiles_%ld", time(NULL));
    create_directory(cfg->tile_dir);
    
    int tiles_x = (cfg->width + cfg->tile_size - 1) / cfg->tile_size;
    int tiles_y = (cfg->height + cfg->tile_size - 1) / cfg->tile_size;
    int total_tiles = tiles_x * tiles_y;
    
    printf("Tiles: %dx%d = %d tiles\n", tiles_x, tiles_y, total_tiles);
    
    double start_time = clock();
    int tile_count = 0;
    
    for (int ty = 0; ty < tiles_y; ty++) {
        for (int tx = 0; tx < tiles_x; tx++) {
            int start_x = tx * cfg->tile_size;
            int start_y = ty * cfg->tile_size;
            int tile_w = (start_x + cfg->tile_size > cfg->width) ? (cfg->width - start_x) : cfg->tile_size;
            int tile_h = (start_y + cfg->tile_size > cfg->height) ? (cfg->height - start_y) : cfg->tile_size;
            
            printf("Rendering tile [%d,%d] (%dx%d)... ", tx, ty, tile_w, tile_h);
            fflush(stdout);
            
            double tile_time = render_tile(cfg, tx, ty, tile_w, tile_h, start_x, start_y);
            if (tile_time < 0) {
                printf("FAILED\n");
                return -1.0;
            }
            printf("done in %.2f sec\n", tile_time);
            tile_count++;
        }
    }
    
    double total_time = (clock() - start_time) / CLOCKS_PER_SEC;
    printf("\nAll %d tiles rendered in %.2f seconds\n", tile_count, total_time);
    
    // Stitch tiles together
    stitch_with_imagemagick(cfg);
    
    return total_time;
}

static double gpu_render_tiled(Config* cfg, uint8_t* image) {
    (void)image;
    printf("\n=== GPU TILE RENDERING MODE ===\n");
    printf("Tile size: %dx%d pixels\n", cfg->tile_size, cfg->tile_size);
    printf("Image size: %dx%d pixels\n", cfg->width, cfg->height);
    
    if (!g_ctx.initialized && !gpu_init()) return -1.0;
    gpu_print_info();
    
    snprintf(cfg->tile_dir, sizeof(cfg->tile_dir), "tiles_%ld", time(NULL));
    create_directory(cfg->tile_dir);
    
    int tiles_x = (cfg->width + cfg->tile_size - 1) / cfg->tile_size;
    int tiles_y = (cfg->height + cfg->tile_size - 1) / cfg->tile_size;
    int total_tiles = tiles_x * tiles_y;
    
    printf("Tiles: %dx%d = %d tiles\n", tiles_x, tiles_y, total_tiles);
    
    double start_time = (double)clock();
    double total_dx = (cfg->x_max - cfg->x_min) / cfg->width;
    double total_dy = (cfg->y_max - cfg->y_min) / cfg->height;
    int tile_count = 0;
    
    for (int ty = 0; ty < tiles_y; ty++) {
        for (int tx = 0; tx < tiles_x; tx++) {
            int start_x = tx * cfg->tile_size;
            int start_y = ty * cfg->tile_size;
            int tile_w = (start_x + cfg->tile_size > cfg->width) ? (cfg->width - start_x) : cfg->tile_size;
            int tile_h = (start_y + cfg->tile_size > cfg->height) ? (cfg->height - start_y) : cfg->tile_size;
            
            double tile_x_min = cfg->x_min + start_x * total_dx;
            double tile_x_max = tile_x_min + tile_w * total_dx;
            double tile_y_min = cfg->y_min + start_y * total_dy;
            double tile_y_max = tile_y_min + tile_h * total_dy;
            
            printf("Rendering tile [%d,%d] (%dx%d)... ", tx, ty, tile_w, tile_h);
            fflush(stdout);
            
            Config tile_cfg = *cfg;
            tile_cfg.width = tile_w;
            tile_cfg.height = tile_h;
            tile_cfg.x_min = tile_x_min;
            tile_cfg.x_max = tile_x_max;
            tile_cfg.y_min = tile_y_min;
            tile_cfg.y_max = tile_y_max;
            tile_cfg.use_tiles = 0;  // Prevent recursion
            
            uint8_t* tile_image = (uint8_t*)malloc(tile_w * tile_h * 3);
            if (!tile_image) {
                printf("Memory allocation failed\n");
                return -1.0;
            }
            
            size_t image_size = tile_w * tile_h * 3;
            cl_int err;
            cl_event event;
            
            g_ctx.buffer_output = clCreateBuffer(g_ctx.context, CL_MEM_WRITE_ONLY, image_size, NULL, &err);
            if (err != CL_SUCCESS) {
                printf("Failed to create buffer\n");
                free(tile_image);
                return -1.0;
            }
            
            err = clSetKernelArg(g_ctx.kernel, 0, sizeof(cl_mem), &g_ctx.buffer_output);
            
            if (g_ctx.supports_double) {
                double x_min = tile_cfg.x_min, x_max = tile_cfg.x_max, y_min = tile_cfg.y_min, y_max = tile_cfg.y_max;
                err |= clSetKernelArg(g_ctx.kernel, 1, sizeof(double), &x_min);
                err |= clSetKernelArg(g_ctx.kernel, 2, sizeof(double), &x_max);
                err |= clSetKernelArg(g_ctx.kernel, 3, sizeof(double), &y_min);
                err |= clSetKernelArg(g_ctx.kernel, 4, sizeof(double), &y_max);
            } else {
                float x_min = tile_cfg.x_min, x_max = tile_cfg.x_max, y_min = tile_cfg.y_min, y_max = tile_cfg.y_max;
                err |= clSetKernelArg(g_ctx.kernel, 1, sizeof(float), &x_min);
                err |= clSetKernelArg(g_ctx.kernel, 2, sizeof(float), &x_max);
                err |= clSetKernelArg(g_ctx.kernel, 3, sizeof(float), &y_min);
                err |= clSetKernelArg(g_ctx.kernel, 4, sizeof(float), &y_max);
            }
            
            err |= clSetKernelArg(g_ctx.kernel, 5, sizeof(int), &tile_cfg.width);
            err |= clSetKernelArg(g_ctx.kernel, 6, sizeof(int), &tile_cfg.height);
            err |= clSetKernelArg(g_ctx.kernel, 7, sizeof(int), &tile_cfg.max_iter);
            err |= clSetKernelArg(g_ctx.kernel, 8, sizeof(int), &tile_cfg.grayscale);
            err |= clSetKernelArg(g_ctx.kernel, 9, sizeof(float), &tile_cfg.gamma);
            err |= clSetKernelArg(g_ctx.kernel, 10, sizeof(float), &tile_cfg.brightness);
            
            if (err != CL_SUCCESS) {
                printf("Failed to set kernel arguments\n");
                clReleaseMemObject(g_ctx.buffer_output);
                free(tile_image);
                return -1.0;
            }
            
            size_t global_work_size[2] = {tile_cfg.width, tile_cfg.height};
            size_t local_work_size[2] = {16, 16};
            if (global_work_size[0] % local_work_size[0] != 0) local_work_size[0] = 1;
            if (global_work_size[1] % local_work_size[1] != 0) local_work_size[1] = 1;
            
            err = clEnqueueNDRangeKernel(g_ctx.queue, g_ctx.kernel, 2, NULL, global_work_size, local_work_size, 0, NULL, &event);
            if (err != CL_SUCCESS) {
                printf("Failed to execute kernel\n");
                clReleaseMemObject(g_ctx.buffer_output);
                free(tile_image);
                return -1.0;
            }
            
            clWaitForEvents(1, &event);
            err = clEnqueueReadBuffer(g_ctx.queue, g_ctx.buffer_output, CL_TRUE, 0, image_size, tile_image, 0, NULL, NULL);
            
            cl_ulong start_gpu, end_gpu;
            clGetEventProfilingInfo(event, CL_PROFILING_COMMAND_START, sizeof(start_gpu), &start_gpu, NULL);
            clGetEventProfilingInfo(event, CL_PROFILING_COMMAND_END, sizeof(end_gpu), &end_gpu, NULL);
            double tile_time = (end_gpu - start_gpu) * 1e-9;
            
            clReleaseEvent(event);
            clReleaseMemObject(g_ctx.buffer_output);
            g_ctx.buffer_output = 0;
            
            char tile_filename[512];
            snprintf(tile_filename, sizeof(tile_filename), "%s/tile_%d_%d.png", cfg->tile_dir, tx, ty);
            FILE* fp = fopen(tile_filename, "wb");
            if (fp) {
                png_structp png_ptr = png_create_write_struct(PNG_LIBPNG_VER_STRING, NULL, NULL, NULL);
                if (png_ptr) {
                    png_infop info_ptr = png_create_info_struct(png_ptr);
                    if (info_ptr && !setjmp(png_jmpbuf(png_ptr))) {
                        png_init_io(png_ptr, fp);
                        png_set_IHDR(png_ptr, info_ptr, tile_w, tile_h, 8, PNG_COLOR_TYPE_RGB,
                                     PNG_INTERLACE_NONE, PNG_COMPRESSION_TYPE_DEFAULT, PNG_FILTER_TYPE_DEFAULT);
                        png_write_info(png_ptr, info_ptr);
                        png_bytep row_pointers[tile_h];
                        for (int y = 0; y < tile_h; y++)
                            row_pointers[y] = (png_bytep)(tile_image + y * tile_w * 3);
                        png_write_image(png_ptr, row_pointers);
                        png_write_end(png_ptr, NULL);
                    }
                    png_destroy_write_struct(&png_ptr, &info_ptr);
                }
                fclose(fp);
            }
            
            free(tile_image);
            tile_count++;
            printf("done in %.2f sec\n", tile_time);
        }
    }
    
    double total_time = ((double)clock() - start_time) / CLOCKS_PER_SEC;
    printf("\nAll %d tiles rendered in %.2f seconds\n", tile_count, total_time);
    printf("Tiles saved to directory: %s\n", cfg->tile_dir);
    
    // Stitch tiles together
    stitch_with_imagemagick(cfg);
    
    return total_time;
}

static double gpu_render(Config* cfg, uint8_t* image) {
    size_t image_size = (size_t)cfg->width * cfg->height * 3;
    
    if (cfg->use_tiles) {
        printf("Using tile rendering...\n");
        return gpu_render_tiled(cfg, image);
    }
    
    if (!g_ctx.initialized && !gpu_init()) return -1.0;
    
    cl_int err;
    cl_event event;
    double render_time = 0.0;
    
    g_ctx.buffer_output = clCreateBuffer(g_ctx.context, CL_MEM_WRITE_ONLY, image_size, NULL, &err);
    if (err != CL_SUCCESS) { fprintf(stderr, "Failed to create buffer\n"); return -1.0; }
    
    err = clSetKernelArg(g_ctx.kernel, 0, sizeof(cl_mem), &g_ctx.buffer_output);
    
    if (g_ctx.supports_double) {
        double x_min = cfg->x_min, x_max = cfg->x_max, y_min = cfg->y_min, y_max = cfg->y_max;
        err |= clSetKernelArg(g_ctx.kernel, 1, sizeof(double), &x_min);
        err |= clSetKernelArg(g_ctx.kernel, 2, sizeof(double), &x_max);
        err |= clSetKernelArg(g_ctx.kernel, 3, sizeof(double), &y_min);
        err |= clSetKernelArg(g_ctx.kernel, 4, sizeof(double), &y_max);
    } else {
        float x_min = cfg->x_min, x_max = cfg->x_max, y_min = cfg->y_min, y_max = cfg->y_max;
        err |= clSetKernelArg(g_ctx.kernel, 1, sizeof(float), &x_min);
        err |= clSetKernelArg(g_ctx.kernel, 2, sizeof(float), &x_max);
        err |= clSetKernelArg(g_ctx.kernel, 3, sizeof(float), &y_min);
        err |= clSetKernelArg(g_ctx.kernel, 4, sizeof(float), &y_max);
    }
    
    err |= clSetKernelArg(g_ctx.kernel, 5, sizeof(int), &cfg->width);
    err |= clSetKernelArg(g_ctx.kernel, 6, sizeof(int), &cfg->height);
    err |= clSetKernelArg(g_ctx.kernel, 7, sizeof(int), &cfg->max_iter);
    err |= clSetKernelArg(g_ctx.kernel, 8, sizeof(int), &cfg->grayscale);
    err |= clSetKernelArg(g_ctx.kernel, 9, sizeof(float), &cfg->gamma);
    err |= clSetKernelArg(g_ctx.kernel, 10, sizeof(float), &cfg->brightness);
    
    if (err != CL_SUCCESS) { fprintf(stderr, "Failed to set kernel arguments\n"); return -1.0; }
    
    size_t global_work_size[2] = {cfg->width, cfg->height};
    size_t local_work_size[2] = {16, 16};
    if (global_work_size[0] % local_work_size[0] != 0) local_work_size[0] = 1;
    if (global_work_size[1] % local_work_size[1] != 0) local_work_size[1] = 1;
    
    err = clEnqueueNDRangeKernel(g_ctx.queue, g_ctx.kernel, 2, NULL, global_work_size, local_work_size, 0, NULL, &event);
    if (err != CL_SUCCESS) { fprintf(stderr, "Failed to execute kernel\n"); return -1.0; }
    
    clWaitForEvents(1, &event);
    err = clEnqueueReadBuffer(g_ctx.queue, g_ctx.buffer_output, CL_TRUE, 0, image_size, image, 0, NULL, NULL);
    
    cl_ulong start, end;
    clGetEventProfilingInfo(event, CL_PROFILING_COMMAND_START, sizeof(start), &start, NULL);
    clGetEventProfilingInfo(event, CL_PROFILING_COMMAND_END, sizeof(end), &end, NULL);
    render_time = (end - start) * 1e-9;
    
    clReleaseEvent(event);
    clReleaseMemObject(g_ctx.buffer_output);
    g_ctx.buffer_output = 0;
    
    return render_time;
}

